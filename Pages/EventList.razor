@page "/"
@using EventEase.Models
@using EventEase.Components
@using EventEase.Services


<h3>Lista de Eventos Otimizada - EventEase</h3>

<div style="margin-bottom: 20px;">
    <NavLink class="btn btn-primary" href="details">Ir para Detalhes</NavLink> | 
    <NavLink class="btn btn-secondary" href="registration">Ir para Inscrição</NavLink>
</div>

<div class="d-flex flex-wrap">
    @if (mockEvents == null || !mockEvents.Any())
    {
        <p>Carregando eventos...</p>
    }
    else
    {
        @foreach (var ev in mockEvents)
        {
            <EventCard @key="ev.Id" EventData="ev" />
        }
    }
</div>

@code {
    private List<EventModel> mockEvents = new();

    protected override void OnInitialized()
    {
        mockEvents = new List<EventModel>
        {
            // ADICIONE OS IDs AQUI:
            new EventModel { Id = 1, Name = "Conferência Tech 2026", Date = new DateTime(2026, 6, 15), Location = "São Paulo - SP" },
            new EventModel { Id = 2, Name = "Workshop de Blazor", Date = new DateTime(2026, 7, 20), Location = "Online" },
            new EventModel { Id = 3, Name = "Networking Corporativo", Date = new DateTime(2026, 8, 05), Location = "Rio de Janeiro - RJ" }
        };
    }
}